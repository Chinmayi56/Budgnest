# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=budgetnest

# --- JWT (used by the authentication system — see README "Authentication") ---
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMTP / Email Verification ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=BudgetNest
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# When SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD above are left blank (e.g.
# while developing locally in VS Code without mail credentials handy),
# the backend will print the login verification code to its own
# console/log instead of failing with a 503. Set to false to disable
# that fallback (e.g. in production you want a hard failure instead of
# silently logging codes).
EMAIL_DEV_CONSOLE_FALLBACK=true
